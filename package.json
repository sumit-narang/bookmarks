{
  "name": "bookmarks-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm --workspace @bookmarks/mobile run start",
    "android": "npm --workspace @bookmarks/mobile run android",
    "ios": "npm --workspace @bookmarks/mobile run ios",
    "web": "npm --workspace @bookmarks/mobile run web",
    "mobile:start": "npm --workspace @bookmarks/mobile run start",
    "mobile:e2e:backend:start": "npm --workspace @bookmarks/backend run start:e2e",
    "mobile:e2e:android": "./scripts/mobileE2eAndroid.sh",
    "backend:start": "npm --workspace @bookmarks/backend run start",
    "cli": "npm --workspace @bookmarks/cli run cli --",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test BOOKMARKS_AUTH_TOKEN_SECRET=bookmarks-test-auth-secret node --import tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "~19.1.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
